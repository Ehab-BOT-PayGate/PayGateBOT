# هذان السطران فقط يبقيان في الكود/الاستضافة (متغيرات بيئة)
# لأن البوت يحتاجهما ليصل أصلاً إلى Google Sheet الذي يحتوي كل الإعدادات الأخرى (التوكن، المدير، القناة، الدعم)

# معرف ملف Google Sheet (من رابط الشيت، الجزء بين d/ و /edit)
GOOGLE_SHEET_ID=PUT_YOUR_SHEET_ID_HERE

# مسار ملف اعتماد حساب الخدمة (Service Account JSON) الذي حمّلته من Google Cloud
GOOGLE_CREDENTIALS_FILE=credentials.json
